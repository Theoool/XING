APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-only-change-me
LOG_LEVEL=INFO
SQL_ECHO=false
CORS_ORIGINS=*

# 宿主机端口映射，改这里不影响容器之间的内网地址
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

POSTGRES_USER=xing
POSTGRES_PASSWORD=xing_dev_pwd
POSTGRES_DB=xing

# 应用连接角色（非超级用户，RLS 才生效）。改这里要同步改 docker/postgres/init/02-app-role.sql
APP_DB_PASSWORD=xing_app_dev_pwd

# 留空则用上面的默认值：
#   DATABASE_URL       -> xing_app@db/xing  （业务运行时，受 RLS 约束）
#   DATABASE_ADMIN_URL -> xing@db/xing      （仅 alembic 迁移使用）
# DATABASE_URL=postgresql+asyncpg://xing_app:xing_app_dev_pwd@db:5432/xing
# DATABASE_ADMIN_URL=postgresql+asyncpg://xing:xing_dev_pwd@db:5432/xing

# 应用连接串。留空则由上面三个变量自动拼装，用超级用户连接 ——
# 开发方便，但 PostgreSQL 的 RLS 对超级用户和表 owner 不生效。
#
# 要让 16 条 policy 真正起作用：
#   1. 执行一次 scripts/app_role.sql 创建 xing_app 角色
#   2. 取消下面一行的注释
#   3. 应用层在每个事务里 SET LOCAL app.user_id / app.workspace_id
#      没有设置上下文时，所有带 RLS 的表都查不到数据（默认拒绝）
# DATABASE_URL=postgresql+asyncpg://xing_app:xing_app_dev_pwd@db:5432/xing

# 容器启动时自动 alembic upgrade head；设为 0 可跳过
RUN_MIGRATIONS=1

OPENAI_API_KEY=
OPENAI_BASE_URL=
